# Konfigurace MCP serveru pro Volby ČR 2026

# Server host a port
HOST=0.0.0.0
PORT=8088

# Volitelný autentizační token (Bearer token).
# Pokud je prázdný, server je veřejně přístupný.
# Pro nasazení na Azure VM doporučeno nastavit silný klíč.
API_KEY=

# URL Českého statistického úřadu
CSU_BASE_URL=https://volby.gov.cz

# Kódy voleb (pro rok 2026 jsou termíny 9.–10. října 2026)
SENAT_ELECTION_CODE=20261009
KV_ELECTION_CODE=20261009
KV_VERSION=kv2026

# Nastavení mezipaměti (cache TTL v sekundách, ČSÚ má cache 60s)
CACHE_TTL_SECONDS=30

# HTTP klient nastavení
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3

# Adresář pro lokální data a číselníky
DATA_DIR=./data
